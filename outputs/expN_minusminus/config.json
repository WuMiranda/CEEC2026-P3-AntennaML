{
  "data_dir": "0514",
  "x_csv": "x_train.csv",
  "y_csv": "y_train.csv",
  "out_dir": "outputs/expN_minusminus",
  "seed": 42,
  "split": [
    0.6,
    0.2,
    0.2
  ],
  "split_mode": "hierarchical_within_label:itState",
  "epochs": 200,
  "batch_size": 256,
  "hidden_dims": [
    64,
    32
  ],
  "lr": 0.001,
  "weight_decay": 0.0001,
  "beta": 0.999,
  "tau": 0.5,
  "derived_features": true,
  "feature_set": "full",
  "it_encoding": "bits",
  "use_itstate_features": true,
  "freq_bins": 10,
  "freq_bin_mode": "onehot",
  "use_closed_state_interactions": false,
  "use_impedance_features": false,
  "rf_features": "vswr_rl",
  "vswr_clip": 100.0,
  "exclude_features": [
    "rl",
    "g1_mag",
    "g1_phase",
    "delta_mag",
    "delta_phase",
    "delta_im",
    "delta_re"
  ],
  "use_log_magnitude_ratio": false,
  "log_ratio_eps": 1e-06,
  "log_ratio_lower_quantile": 0.001,
  "log_ratio_upper_quantile": 0.999,
  "log_ratio_lower": null,
  "log_ratio_upper": null,
  "z0": 50.0,
  "gamma_scale": 32768.0,
  "geometry_mode": "none",
  "freq_tree_depth": 0,
  "freq_tree_min_leaf": 200,
  "freq_tree_candidates": 128,
  "feature_dim": 23,
  "split_indices_dir": "outputs/feature_ablation_tau05/shared_split",
  "device_auto": "cuda"
}